# Gitea configuration
GIT_PROVIDER=gitea
GITEA_URL=<gitea_api_token>
GITEA_TOKEN=<gitea_api_token>
WEBHOOK_SECRET=<webhook_secret>

# AI model configuration (self-hosted OpenAI-compatible endpoint)
OPENAI_KEY=<openai_api_key>
OPENAI_API_BASE=https://your-openai-compatible-endpoint/v1
MODEL=gpt-5.5
CUSTOM_MODEL_MAX_TOKENS=65536
FALLBACK_MODELS=[]
RESPONSE_LANGUAGE=zh-CN

# webhook server.
SKIP_SSL_VERIFICATION=false

# Automatic commands for new or reopened pull requests.
PR_COMMANDS=["/review"]

# Set to true if pushes to an existing PR should trigger another review pass.
HANDLE_PUSH_TRIGGER=false
PUSH_COMMANDS=["/review"]
